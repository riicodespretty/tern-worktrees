#!/bin/sh
if [ -n "${FAKE_TERN_LOG:-}" ]; then
	printf '%s\n' "$*" >>"$FAKE_TERN_LOG"
fi
verb=${1:-}
if [ -n "${FAKE_TERN_FAIL:-}" ] && [ "$verb" = "$FAKE_TERN_FAIL" ]; then
	echo "fake tern: $verb failed" >&2
	exit 1
fi
case "$verb" in
ls)
	exec cat "$FAKE_TERN_DIR/ls.json"
	;;
new)
	echo '{"block":42}'
	;;
plugin)
	if [ "${2:-}" = link ]; then
		mkdir -p "$TERN_CONFIG_DIR/plugins"
		printf '%s\n' "$3" >"$TERN_CONFIG_DIR/plugins/tern-worktrees.path"
	fi
	;;
esac
exit 0
