{
  "name": "tern-worktrees",
  "private": true,
  "type": "module",
  "bin": {
    "tern-wt": "bin/tern-wt"
  },
  "scripts": {
    "prepare": "vp config",
    "fmt:luau": "stylua .",
    "check:luau": "stylua --check . && sh scripts/check-luau.sh",
    "lint:prose": "git ls-files -co --exclude-standard -- '*.md' '*.ts' ':!:styles/**' | xargs vale --minAlertLevel=error",
    "test": "vp test",
    "test.mutation": "sh -c '[ \"$1\" != -- ] || shift; iso=$(mktemp -d) && trap \"rm -rf \\\"$iso\\\"\" EXIT && HOME=\"$iso\" TERN_WT_HOME=\"$iso/tern-wt\" TERN_WT_OMP=\"$iso/no-omp\" TERN_CONFIG_DIR=\"$iso/tern-config\" TERN_PLUGIN_DATA=\"$iso/plugin-data\" TERN_DAEMON_SOCKET=\"$iso/no-daemon.sock\" TERN_BIN=\"$PWD/test/fixtures/bin/tern\" XDG_STATE_HOME=\"$iso/state\" XDG_CONFIG_HOME=\"$iso/config\" stryker run \"$@\"' sh",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vvago/vale": "^3.17.1",
    "eslint": "^10.9.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-complexity": "^3.0.1",
    "typescript": "^5.9.3",
    "ultracite": "7.11.0",
    "valibot": "^1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "@vvago/vale"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@vvago/vale@3.24.0": "patches/@vvago%2Fvale@3.24.0.patch"
  }
}
