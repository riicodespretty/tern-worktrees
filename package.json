{
  "name": "tern-worktrees",
  "private": true,
  "type": "module",
  "bin": {
    "tern-wt": "bin/tern-wt"
  },
  "scripts": {
    "prepare": "vp config",
    "fmt:luau": "stylua .",
    "check:luau": "stylua --check . && sh -c 'ls *.luau >/dev/null 2>&1 || exit 0; luau-lsp analyze --platform=standard --definitions=@tern=types/tern.d.luau *.luau'",
    "lint:prose": "git ls-files -co --exclude-standard -- '*.md' '*.ts' ':!:styles/**' | xargs vale --minAlertLevel=error",
    "test": "vp test",
    "test.mutation": "stryker run",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "@vvago/vale": "^3.17.1",
    "eslint": "^10.9.1",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-complexity": "^3.0.1",
    "typescript": "^5.9.3",
    "ultracite": "7.11.0",
    "valibot": "^1.5.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "@vvago/vale"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  }
}
